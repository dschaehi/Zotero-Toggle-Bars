{
	"manifest_version": 2,
	"name": "Zotero Focused Mode",
	"version": "0.6.5",
	"description": "A plugin that enables a distraction-free workspace for focused reading.",
	"homepage_url": "https://github.com/dschaehi/Zotero-Focused-Mode/",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"64": "icons/icon-64.png"
	},
	"applications": {
		"zotero": {
			"id": "zotero-focused-mode@jaeheelee.de",
			"update_url": "https://raw.githubusercontent.com/dschaehi/Zotero-Focused-Mode/main/update.json",
			"strict_min_version": "6.999",
			"strict_max_version": "10.0.*"
		}
	}
}
